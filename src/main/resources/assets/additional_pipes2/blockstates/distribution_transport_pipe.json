{
  "multipart": [
    {
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_core"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_arm_down",
        "x": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_arm_up",
        "x": 270
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_arm_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_arm_south",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_arm_west",
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "additional_pipes2:block/pipe/distribution_transport_pipe_arm_east",
        "y": 90
      }
    }
  ]
}
